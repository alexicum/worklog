{
  "name": "@repo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": "./src/*"
  },
  "scripts": {
    "clean:dist": "rm -rf dist .turbo tsconfig.tsbuildinfo",
    "build": "pnpm clean:dist && tsc --build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch --clear-screen=false src/server.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@repo/database": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
