{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "#api/*": ["./src/*"],
      "@repo/schemas": ["../../packages/schemas/src/index.ts"],
      "@repo/database": ["../../packages/database/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/schemas" },
    { "path": "../../packages/database" }
  ]
}
