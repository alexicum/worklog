datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model WorkLog {
  id             String   @id @default(uuid())
  doneAt         DateTime @default(now())
  workTypeName   String
  volume         Float
  workTypeUnit   String
  workerName     String
  workerTypeName String
}
