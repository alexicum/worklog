datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

model WorkLog {
  id             String   @id @default(uuid())
  doneAt         DateTime @default(now())
  workTypeName   String
  volume         Float
  workTypeUnit   String
  workerName     String
  workerTypeName String
}
