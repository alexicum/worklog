{
  "name": "@repo/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean:dist": "rm -rf dist .turbo tsconfig.tsbuildinfo src/generated",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --force-reset",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma generate && prisma db push --force-reset && prisma db seed",
    "db:studio": "prisma studio",
    "build": "tsc --build",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "dev": "tsc --build --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
