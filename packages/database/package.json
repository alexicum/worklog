{
  "name": "@repo/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "build": "pnpm clean && pnpm db:generate && tsc",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "dev": "pnpm clean && pnpm db:generate && tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
