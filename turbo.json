{
  "$schema": "./node_modules/turbo/schema.json",
  "globalEnv": ["DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["clean:dist", "db:generate", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production",
        ".env"
      ],      
      "outputs": ["dist/**", "src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean:dist": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production",
        ".env"
      ],
      "env": ["DATABASE_URL"]
    },
    "db:generate": { 
      "cache": false
    }, 
    "db:push": { 
      "cache": false
    },
    "db:migrate": { 
      "cache": false
    },
    "db:seed": { 
      "cache": false
    }, 
    "db:reset": { 
      "cache": false
    }, 
  }
}