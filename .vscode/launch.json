    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "API server",
            "command": "pnpm dev",
            "cwd": "${workspaceFolder}/apps/api",
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
        }
    ]
}